rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /leaderboard/{scoreId} {
      allow read: if true;

      allow create: if
        request.resource.data.keys().hasOnly([
          "playerName",
          "score",
          "difficulty",
          "rounds",
          "maxPossible",
          "createdAt"
        ]) &&
        request.resource.data.playerName is string &&
        request.resource.data.playerName.size() >= 2 &&
        request.resource.data.playerName.size() <= 18 &&
        request.resource.data.score is int &&
        request.resource.data.score >= 0 &&
        request.resource.data.rounds is int &&
        request.resource.data.rounds in [5, 10, 15] &&
        request.resource.data.maxPossible is int &&
        request.resource.data.maxPossible == request.resource.data.rounds * 1000 &&
        request.resource.data.score <= request.resource.data.maxPossible &&
        request.resource.data.difficulty in ["Easy", "Medium", "Hard"] &&
        request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }
  }
}
